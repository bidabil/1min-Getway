# ============================================================
# .dockerignore - allow-list: only what the image needs is sent to the build.
# Note: Docker does not support comments at the end of a pattern line.
# ============================================================
*
!src/
!requirements.txt
!pyproject.toml
!README.md
!LICENSE

# Never ship caches, bytecode or local secrets, even inside src/
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.key
**/*.pem
