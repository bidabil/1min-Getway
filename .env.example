# ==============================================================================
# 1min-Gateway configuration template
# cp .env.example .env, then fill in the two REQUIRED values.
# Comments must stay on their own lines (docker --env-file keeps trailing text).
# ==============================================================================

# --- REQUIRED ------------------------------------------------------------------
# Your 1min.ai API key (https://app.1min.ai -> API). Stays on the server.
ONE_MIN_API_KEY=

# Keys your agents use to call the gateway, as name:sha256[:requests_per_minute].
# Create one with:  python -m gateway.cli create-key my-agent
# (Docker: docker compose run --rm gateway python -m gateway.cli create-key my-agent)
GATEWAY_API_KEYS=

# --- Server --------------------------------------------------------------------
# Container port and number of uvicorn workers (in-memory limits are per worker).
PORT=5001
WORKERS=1
LOG_LEVEL=INFO
# json or text
LOG_FORMAT=json
# Default requests per minute for each gateway key (0 = unlimited).
RATE_LIMIT_RPM=60
MAX_REQUEST_BODY_MB=32
# Comma-separated browser origins allowed to call the gateway (empty = none).
CORS_ORIGINS=
# Serve /docs and /openapi.json (keep false in production).
DOCS_ENABLED=false
# Enables /metrics for Prometheus when set (send it as a Bearer token).
METRICS_TOKEN=
# Reverse proxies whose X-Forwarded-For header is trusted (uvicorn).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Models and routing --------------------------------------------------------
# Map the model names your agents send to 1min.ai models (exact or wildcard).
# Example for Claude-based agents:  claude-*=gpt-5.1,my-fast-model=gpt-4o-mini
MODEL_ALIASES=
# Chat with AI models are read from 1min.ai's public catalog. Add extra ids here only if needed.
LEGACY_CHAT_MODELS=
# Append this suffix to a model name to enable 1min.ai web search (e.g. gpt-4o-mini:online).
WEB_SEARCH_SUFFIX=:online
# Drop temperature/top_p/stop for models that reject them (reasoning models, DeepSeek, GLM).
DROP_UNSUPPORTED_SAMPLING_PARAMS=true

# --- Timeouts ------------------------------------------------------------------
CHAT_TIMEOUT_S=150
FEATURE_TIMEOUT_S=300

# --- MCP server (/mcp) ---------------------------------------------------------
MCP_ENABLED=true
# Public host names of the gateway (e.g. ai.example.com), enables DNS-rebinding protection.
MCP_ALLOWED_HOSTS=
# Chat model used by the MCP web_search / analyze_image tools.
DEFAULT_TOOL_MODEL=gpt-4o-mini
